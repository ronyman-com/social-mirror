{
  "name": "facebook-mirror",
  "version": "1.0.0",
  "description": "ReadME facebook api",
  "type": "module",
  "scripts": {
    "nuke": "rimraf dist node_modules package-lock.json .cache",
    "reset": "npm run nuke && npm install",
    "build:watch": "nodemon --watch templates bin/build.js",
    "build": "readme build",
    "start": "readme start",
    "dev": "concurrently \"npm run build:watch\" \"nodemon app.js\"",
    "dev:server": "nodemon --watch app.js --watch config --watch routes --watch models app.js",
    "dev:build": "nodemon --watch templates --watch bin bin/build.js",
    "prod": "npm run build && NODE_ENV=production npm start",
    "serve": "serve dist",
    "optimize-seo": "npm-seo-optimize",
    "lint": "eslint .",
    "test": "jest --watchAll",
    "fb:login": "firebase login",
    "fb:deploy": "firebase deploy"
  },
  "watch": [
    "bin",
    "templates",
    "routes",
    "app.js"
  ],
  "ext": "js,ejs,json",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronyman-com/facebook-mirror.git"
  },
  "keywords": [
    "readme-framework",
    "readme",
    "facebook",
    "ronyman",
    "readme-framework"
  ],
  "author": "Rony MAN",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ronyman-com/facebook-mirror/issues"
  },
  "homepage": "https://github.com/ronyman-com/facebook-mirror#readme",
  "dependencies": {
    "axios": "^1.8.4",
    "bcryptjs": "^3.0.2",
    "commander": "^13.1.0",
    "connect-flash": "^0.1.1",
    "connect-session-firebase": "^11.0.0",
    "cookie-parser": "^1.4.7",
    "csurf": "^1.11.0",
    "dotenv": "^16.5.0",
    "ejs": "^3.1.10",
    "express": "5.1.0",
    "express-flash": "^0.0.2",
    "express-session": "^1.18.1",
    "firebase": "^11.6.1",
    "gray-matter": "^4.0.3",
    "html-minifier": "^4.0.0",
    "npm-seo-optimizer": "^1.0.0",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "path-to-regexp": "8.2.0",
    "readme-framework": "^1.2.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.10"
  }
}
