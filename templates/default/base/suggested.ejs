<div class="suggested-section card">
    <div class="section-header">
      <h3>Suggested for You</h3>
    </div>
    
    <% if (typeof suggested !== 'undefined' && suggested.length > 0) { %>
      <div class="suggested-items">
        <% suggested.forEach(item => { %>
          <div class="suggested-item">
            <img src="<%= item.avatar %>" alt="<%= item.name %>">
            <div class="item-info">
              <h4><%= item.name %></h4>
              <p><%= item.mutualFriends %> mutual friends</p>
              <div class="item-actions">
                <button class="add-friend">Add Friend</button>
                <button class="remove">Remove</button>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="no-suggestions">
        <i class="fas fa-user-friends"></i>
        <p>No suggestions available</p>
      </div>
    <% } %>
    
    <button class="see-all">See All Suggestions</button>
  </div>
  
  <style>
  .suggested-section {
    padding: 12px;
    margin-bottom: 16px;
  }
  
  .suggested-items {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  
  .suggested-item {
    display: flex;
    gap: 12px;
  }
  
  .suggested-item img {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
  }
  
  .item-info {
    flex: 1;
  }
  
  .item-info h4 {
    font-size: 15px;
  }
  
  .item-info p {
    font-size: 13px;
    color: var(--text-secondary);
    margin: 4px 0;
  }
  
  .item-actions {
    display: flex;
    gap: 8px;
  }
  
  .add-friend {
    background: var(--primary-blue);
    color: white;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 13px;
    cursor: pointer;
  }
  
  .remove {
    background: var(--hover-gray);
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 13px;
    cursor: pointer;
  }
  
  .no-suggestions {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 16px;
    color: var(--text-secondary);
  }
  
  .no-suggestions i {
    font-size: 24px;
    margin-bottom: 8px;
  }
  
  .see-all {
    width: 100%;
    background: none;
    border: none;
    padding: 8px;
    color: var(--primary-blue);
    font-weight: 600;
    cursor: pointer;
    border-radius: 4px;
    margin-top: 8px;
  }
  
  .see-all:hover {
    background: var(--hover-gray);
  }
  </style>