<div class="shortcuts-section">
    <div class="section-header">
      <h3>Your Shortcuts</h3>
    </div>
    
    <div class="shortcut-items">
      <% if (typeof shortcuts !== 'undefined' && shortcuts.length > 0) { %>
        <% shortcuts.forEach(shortcut => { %>
          <a href="<%= shortcut.url %>" class="shortcut-item">
            <% if (shortcut.icon) { %>
              <i class="<%= shortcut.icon %>"></i>
            <% } else { %>
              <img src="<%= shortcut.image %>" alt="<%= shortcut.name %>">
            <% } %>
            <span><%= shortcut.name %></span>
          </a>
        <% }); %>
      <% } else { %>
        <div class="no-shortcuts">
          <i class="fas fa-bookmark"></i>
          <p>No shortcuts added</p>
        </div>
      <% } %>
    </div>
    
    <button class="edit-shortcuts">
      <i class="fas fa-edit"></i> Edit Shortcuts
    </button>
  </div>
  
  <style>
  .shortcuts-section {
    padding: 12px 0;
  }
  
  .shortcut-items {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  
  .shortcut-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--text-primary);
  }
  
  .shortcut-item:hover {
    background: var(--hover-gray);
  }
  
  .shortcut-item i {
    width: 20px;
    text-align: center;
    font-size: 18px;
  }
  
  .shortcut-item img {
    width: 20px;
    height: 20px;
    border-radius: 4px;
  }
  
  .no-shortcuts {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 16px;
    color: var(--text-secondary);
  }
  
  .no-shortcuts i {
    font-size: 24px;
    margin-bottom: 8px;
  }
  
  .edit-shortcuts {
    width: 100%;
    background: none;
    border: none;
    padding: 8px;
    color: var(--primary-blue);
    font-weight: 600;
    cursor: pointer;
    border-radius: 4px;
    margin-top: 8px;
    text-align: left;
  }
  
  .edit-shortcuts:hover {
    background: var(--hover-gray);
  }
  </style>