<!-- post-creator.ejs -->
<div class="post-creator-container">
    <% if (typeof user === 'undefined' || !user) { %>
        <div class="login-prompt">
            <button id="postCreatorFbLoginBtn" class="auth-btn facebook-auth">
                <i class="fab fa-facebook"></i> Continue with Facebook to post
            </button>
        </div>
    <% } else { %>
        <div class="post-creator card">
            <div class="creator-header">
                <img src="<%= user.avatar || '/assets/images/default-avatar.jpg' %>" 
                     alt="<%= user.name || 'User' %>" 
                     class="creator-avatar"
                     onerror="this.onerror=null;this.src='/assets/images/default-avatar.jpg'">
                <input type="text" 
                       placeholder="What's on your mind, <%= user.name ? user.name.split(' ')[0] : 'User' %>?" 
                       class="post-input"
                       id="postContentInput">
            </div>
            
            <div class="creator-divider"></div>
            
            <div class="creator-options">
                <button class="creator-option" data-type="photo">
                    <i class="fas fa-images"></i>
                    <span>Photo/Video</span>
                </button>
                <button class="creator-option" data-type="feeling">
                    <i class="fas fa-smile"></i>
                    <span>Feeling/Activity</span>
                </button>
                <button class="creator-option" data-type="live">
                    <i class="fas fa-video"></i>
                    <span>Live Video</span>
                </button>
            </div>
            
            <input type="file" id="mediaUpload" accept="image/*,video/*" style="display: none;" multiple>
        </div>
        
        <!-- Post Modal -->
        <div id="postModal" class="modal">
            <div class="modal-content">
                <div class="modal-header">
                    <h3>Create Post</h3>
                    <span class="close-modal">&times;</span>
                </div>
                <div class="modal-body">
                    <div id="postError" class="post-error-message" style="display: none;"></div>
                    <div class="media-preview" id="mediaPreview"></div>
                    <textarea id="postText" placeholder="What's on your mind?"></textarea>
                    <div class="privacy-selector">
                        <select id="postPrivacy">
                            <option value="EVERYONE">Public</option>
                            <option value="FRIENDS">Friends</option>
                            <option value="SELF">Only me</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button id="submitPostBtn" class="btn-primary">Post</button>
                </div>
            </div>
        </div>
    <% } %>
</div>



<style>
    /* Post Creator Styles */
    .post-creator-container {
        margin-bottom: 20px;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.1);
        padding: 12px 16px;
    }
    
    .creator-header {
        display: flex;
        align-items: center;
        margin-bottom: 12px;
    }
    
    .creator-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        object-fit: cover;
        margin-right: 12px;
    }
    
    .post-input {
        flex: 1;
        background: #f0f2f5;
        border: none;
        border-radius: 20px;
        padding: 10px 16px;
        font-size: 15px;
        outline: none;
    }
    
    .creator-divider {
        height: 1px;
        background: #ddd;
        margin: 8px 0;
    }
    
    .creator-options {
        display: flex;
        justify-content: space-between;
        padding: 4px 0;
    }
    
    .creator-option {
        flex: 1;
        background: none;
        border: none;
        padding: 8px;
        border-radius: 4px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #65676b;
        font-weight: 600;
    }
    
    .creator-option:hover {
        background: #f0f2f5;
    }
    
    /* Modal Styles */
    .modal {
        display: none;
        position: fixed;
        z-index: 2000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.5);
    }
    
    .modal-content {
        background: white;
        margin: 10% auto;
        padding: 16px;
        border-radius: 8px;
        width: 500px;
        max-width: 90%;
        max-height: 80vh;
        overflow-y: auto;
    }
    
    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 1px solid #ddd;
    }
    
    .close-modal {
        font-size: 24px;
        cursor: pointer;
        color: #65676b;
    }
    
    .media-preview {
        margin-bottom: 16px;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }
    
    .preview-media {
        max-width: 100%;
        max-height: 300px;
        border-radius: 8px;
    }
    
    textarea#postText {
        width: 100%;
        min-height: 100px;
        padding: 12px;
        border-radius: 8px;
        border: 1px solid #ddd;
        resize: vertical;
        margin-bottom: 16px;
        font-family: inherit;
        font-size: 15px;
    }
    
    .btn-primary {
        background: #1877f2;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
    }
    
   
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Post Creator Functionality
        const postContentInput = document.getElementById('postContentInput');
        const postModal = document.getElementById('postModal');
        const closeModalBtn = document.querySelector('.close-modal');
        const mediaUpload = document.getElementById('mediaUpload');
        const submitPostBtn = document.getElementById('submitPostBtn');
        
        // Open modal when clicking on post input
        postContentInput?.addEventListener('click', function() {
            postModal.style.display = 'block';
            document.getElementById('postText').focus();
        });
        
        // Close modal
        closeModalBtn?.addEventListener('click', function() {
            postModal.style.display = 'none';
        });
        
        // Media upload handling
        document.querySelectorAll('.creator-option')?.forEach(button => {
            button.addEventListener('click', function() {
                const type = this.getAttribute('data-type');
                if (type === 'photo') {
                    mediaUpload.click();
                }
            });
        });
        
        // Post submission
        submitPostBtn?.addEventListener('click', async function() {
            const postText = document.getElementById('postText').value;
            const files = mediaUpload.files;
            
            if (!postText.trim() && files.length === 0) {
                alert('Please add some text or media to your post');
                return;
            }
            
            submitPostBtn.disabled = true;
            submitPostBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Posting...';
            
            try {
                const formData = new FormData();
                formData.append('content', postText);
                formData.append('privacy', document.getElementById('postPrivacy').value);
                
                // Add CSRF token if available
                const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
                if (csrfToken) {
                    formData.append('_csrf', csrfToken);
                }
                
                // Add media files
                if (files.length > 0) {
                    Array.from(files).forEach((file, index) => {
                        formData.append(`media_${index}`, file);
                    });
                }
                
                const response = await fetch('/api/posts', {
                    method: 'POST',
                    body: formData
                });
                
                if (!response.ok) {
                    throw new Error('Failed to create post');
                }
                
                window.location.reload();
            } catch (error) {
                console.error('Error creating post:', error);
                alert('Failed to create post. Please try again.');
                submitPostBtn.disabled = false;
                submitPostBtn.textContent = 'Post';
            }
        });
        
        // Like button functionality
        document.querySelectorAll('.like-btn').forEach(button => {
            button.addEventListener('click', async function() {
                const postId = this.getAttribute('data-post-id');
                try {
                    const response = await fetch(`/api/posts/${postId}/like`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    });
                    
                    if (response.ok) {
                        const result = await response.json();
                        const likeCount = this.closest('.post-card').querySelector('.post-likes');
                        likeCount.innerHTML = `<i class="fas fa-thumbs-up"></i> ${result.likes}`;
                        this.innerHTML = `<i class="fas fa-thumbs-up"></i> Liked`;
                    }
                } catch (error) {
                    console.error('Error liking post:', error);
                }
            });
        });
    });
</script>