    // Messenger Dropdown
    const messengerIcon = document.querySelector('.messenger-icon');
    if (messengerIcon) {
      messengerIcon.innerHTML += `
        <div class="messenger-dropdown">
          <div class="dropdown-header">Messenger</div>
          <div class="dropdown-item">
            <img src="https://randomuser.me/api/portraits/women/44.jpg" class="dropdown-avatar">
            <div class="dropdown-item-content">
              <div class="dropdown-item-title">Sarah Johnson</div>
              <div class="dropdown-item-time">Active now</div>
            </div>
          </div>
          <div class="dropdown-item">
            <img src="https://randomuser.me/api/portraits/men/32.jpg" class="dropdown-avatar">
            <div class="dropdown-item-content">
              <div class="dropdown-item-title">Mark Wilson</div>
              <div class="dropdown-item-time">10 min ago</div>
            </div>
          </div>
          <div class="dropdown-item">
            <img src="https://randomuser.me/api/portraits/women/68.jpg" class="dropdown-avatar">
            <div class="dropdown-item-content">
              <div class="dropdown-item-title">Emily Davis</div>
              <div class="dropdown-item-time">1 hour ago</div>
            </div>
          </div>
          <div class="dropdown-see-all">
            <a href="#">See all in Messenger</a>
          </div>
        </div>
      `;
    }

    // Toggle dropdowns
    const toggleDropdown = (dropdown) => {
      const allDropdowns = document.querySelectorAll('.notification-dropdown, .messenger-dropdown, .menu-dropdown, .user-dropdown');
      allDropdowns.forEach(dd => {
        if (dd !== dropdown) {
          dd.style.display = 'none';
        }
      });
      if (dropdown) {
        dropdown.style.display = dropdown.style.display === 'block' ? 'none' : 'block';
      }
    };

    // Notification click handler
    if (notificationIcon) {
      const notificationDropdown = notificationIcon.querySelector('.notification-dropdown');
      notificationIcon.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleDropdown(notificationDropdown);
      });
    }

    // Messenger click handler
    if (messengerIcon) {
      const messengerDropdown = messengerIcon.querySelector('.messenger-dropdown');
      messengerIcon.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleDropdown(messengerDropdown);
      });
    }

    // Close dropdowns when clicking elsewhere
    document.addEventListener('click', () => {
      const allDropdowns = document.querySelectorAll('.notification-dropdown, .messenger-dropdown, .menu-dropdown, .user-dropdown');
      allDropdowns.forEach(dd => {
        dd.style.display = 'none';
      });
    });

    // Avatar style for messenger dropdown
    const style = document.createElement('style');
    style.textContent = `
      .dropdown-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        object-fit: cover;
        margin-right: 12px;
      }
    `;
    document.head.appendChild(style);
  });
</script>