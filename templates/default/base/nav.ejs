<header class="main-header">
    <div class="header-container">
      <!-- Left section with logo and search -->
      <div class="header-left">
        <div class="logo">
          <i class="fab fa-facebook"></i>
        </div>
        <div class="search-bar">
          <i class="fas fa-search"></i>
          <input type="text" placeholder="Search Facebook">
        </div>
      </div>
      
      <!-- Center navigation -->
      <div class="header-center">
        <nav class="main-nav">
          <a href="/" class="nav-item active">
            <i class="fas fa-home"></i>
          </a>
          <a href="#" class="nav-item">
            <i class="fas fa-tv"></i>
          </a>
          <a href="#" class="nav-item">
            <i class="fas fa-store"></i>
          </a>
          <a href="#" class="nav-item">
            <i class="fas fa-users"></i>
          </a>
        </nav>
      </div>
      
      <!-- Right icons -->
      <div class="header-right">
        <div class="menu-icon" id="menuButton">
          <i class="fas fa-bars"></i>
          <div class="menu-dropdown" id="menuDropdown">
            <div class="menu-columns">
              <div class="menu-column">
                <div class="menu-item">
                  <i class="fas fa-calendar"></i>
                  <span>Events</span>
                </div>
                <div class="menu-item">
                  <i class="fas fa-users"></i>
                  <span>Groups</span>
                </div>
                <div class="menu-item">
                  <i class="fas fa-flag"></i>
                  <span>Pages</span>
                </div>
                <div class="menu-item">
                  <i class="fas fa-robot"></i>
                  <span>AI Tools</span>
                </div>
                <div class="menu-item">
                  <i class="fas fa-ellipsis-h"></i>
                  <span>See More</span>
                </div>
              </div>
              <div class="menu-column">
                <div class="menu-item">
                  <i class="fas fa-edit"></i>
                  <span>Create Post</span>
                </div>
                <div class="menu-item">
                  <i class="fas fa-video"></i>
                  <span>Create Reel</span>
                </div>
                <div class="menu-item">
                  <i class="fas fa-calendar-plus"></i>
                  <span>Create Event</span>
                </div>
                <div class="menu-item">
                  <i class="fas fa-hand-holding-heart"></i>
                  <span>Fundraiser</span>
                </div>
                <div class="menu-item">
                  <i class="fas fa-ad"></i>
                  <span>Create Ad</span>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <div class="notification-icon">
          <i class="fas fa-bell"></i>
          <span class="notification-badge">3</span>
        </div>
        
        <div class="messenger-icon">
          <i class="fas fa-comment-dots"></i>
          <span class="messenger-badge">5</span>
        </div>
        
        <div class="user-icon" id="userMenuButton">
          <% if (typeof user !== 'undefined' && user.avatar) { %>
            <img src="<%= user.avatar %>" class="user-avatar">
          <% } else { %>
            <i class="fas fa-user-circle"></i>
          <% } %>
          <div class="user-dropdown" id="userMenu">
            <div class="user-dropdown-header">
              <div class="user-info">
                <% if (typeof user !== 'undefined' && user.avatar) { %>
                  <img src="<%= user.avatar %>" class="dropdown-avatar">
                <% } else { %>
                  <i class="fas fa-user-circle dropdown-avatar-icon"></i>
                <% } %>
                <div class="user-name"><% if (typeof user === 'undefined') { %>
                    <% user = { name: 'Guest User', avatar: null } %>
                  <% } %></div>
              </div>
              <div class="profile-link">
                <a href="#">See all profiles</a>
              </div>
            </div>
            
            <div class="dropdown-divider"></div>
            
            <div class="dropdown-item">
              <i class="fas fa-user"></i>
              <span>Profile</span>
            </div>
            <div class="dropdown-item">
              <i class="fas fa-comment-alt"></i>
              <span>Feedback</span>
            </div>
            <div class="dropdown-item">
              <i class="fas fa-cog"></i>
              <span>Settings & privacy</span>
              <i class="fas fa-chevron-right"></i>
            </div>
            <div class="dropdown-item">
              <i class="fas fa-question-circle"></i>
              <span>Help & support</span>
              <i class="fas fa-chevron-right"></i>
            </div>
            <div class="dropdown-item">
              <i class="fas fa-moon"></i>
              <span>Display & accessibility</span>
              <i class="fas fa-chevron-right"></i>
            </div>
            <div class="dropdown-item">
              <i class="fas fa-sign-out-alt"></i>
              <span>Log Out</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>
  
