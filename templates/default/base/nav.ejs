  <script>
    // Toggle menu dropdown
    document.getElementById('menuButton').addEventListener('click', function(e) {
      e.stopPropagation();
      const menu = document.getElementById('menuDropdown');
      menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
      // Close user dropdown if open
      document.getElementById('userMenu').style.display = 'none';
    });
  
    // Toggle user dropdown
    document.getElementById('userMenuButton').addEventListener('click', function(e) {
      e.stopPropagation();
      const menu = document.getElementById('userMenu');
      menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
      // Close menu dropdown if open
      document.getElementById('menuDropdown').style.display = 'none';
    });
  
    // Close dropdowns when clicking elsewhere
    document.addEventListener('click', function() {
      document.getElementById('menuDropdown').style.display = 'none';
      document.getElementById('userMenu').style.display = 'none';
    });

    
  // Wait for DOM to be fully loaded
  document.addEventListener('DOMContentLoaded', function() {
    // Toggle menu dropdown
    const menuButton = document.getElementById('menuButton');
    const menuDropdown = document.getElementById('menuDropdown');
    
    if (menuButton) {
      menuButton.addEventListener('click', function(e) {
        e.stopPropagation();
        menuDropdown.style.display = menuDropdown.style.display === 'block' ? 'none' : 'block';
        // Close user dropdown if open
        userMenu.style.display = 'none';
      });
    }

    // Toggle user dropdown
    const userMenuButton = document.getElementById('userMenuButton');
    const userMenu = document.getElementById('userMenu');
    
    if (userMenuButton) {
      userMenuButton.addEventListener('click', function(e) {
        e.stopPropagation();
        userMenu.style.display = userMenu.style.display === 'block' ? 'none' : 'block';
        // Close menu dropdown if open
        menuDropdown.style.display = 'none';
      });
    }

    // Close dropdowns when clicking elsewhere
    document.addEventListener('click', function() {
      if (menuDropdown) menuDropdown.style.display = 'none';
      if (userMenu) userMenu.style.display = 'none';
    });

    // Close dropdowns when pressing Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        if (menuDropdown) menuDropdown.style.display = 'none';
        if (userMenu) userMenu.style.display = 'none';
      }
    });
  });

  </script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // DOM Elements
      const menuButton = document.getElementById('menuButton');
      const menuDropdown = document.getElementById('menuDropdown');
      const userMenuButton = document.getElementById('userMenuButton');
      const userMenu = document.getElementById('userMenu');
      const notificationIcon = document.querySelector('.notification-icon');
      const messengerIcon = document.querySelector('.messenger-icon');
      
      // Create dropdown elements for notifications and messenger if they don't exist
      const createDropdown = (parent, content) => {
        let dropdown = parent.querySelector('.dropdown');
        if (!dropdown) {
          dropdown = document.createElement('div');
          dropdown.className = 'dropdown';
          dropdown.innerHTML = content;
          parent.appendChild(dropdown);
          
          // Position the dropdown below the icon
          const rect = parent.getBoundingClientRect();
          dropdown.style.position = 'absolute';
          dropdown.style.top = `${rect.bottom + window.scrollY}px`;
          dropdown.style.right = `${window.innerWidth - rect.right}px`;
        }
        return dropdown;
      };
  
      // Toggle any dropdown
      const toggleDropdown = (dropdown, closeOthers = true) => {
        if (closeOthers) {
          closeAllDropdowns();
        }
        if (dropdown) {
          dropdown.style.display = dropdown.style.display === 'block' ? 'none' : 'block';
        }
      };
  
      // Close all dropdowns
      const closeAllDropdowns = () => {
        const allDropdowns = document.querySelectorAll('.dropdown, .menu-dropdown, .user-dropdown');
        allDropdowns.forEach(dropdown => {
          dropdown.style.display = 'none';
        });
      };
  
      // Menu Dropdown
      if (menuButton && menuDropdown) {
        menuButton.addEventListener('click', function(e) {
          e.stopPropagation();
          toggleDropdown(menuDropdown);
        });
      }
  
      // User Dropdown
      if (userMenuButton && userMenu) {
        userMenuButton.addEventListener('click', function(e) {
          e.stopPropagation();
          toggleDropdown(userMenu);
        });
      }
  
      // Notification Dropdown
      if (notificationIcon) {
        notificationIcon.addEventListener('click', function(e) {
          e.stopPropagation();
          const dropdown = createDropdown(notificationIcon, `
            <div class="dropdown-content">
              <div class="dropdown-header">Notifications</div>
              <div class="dropdown-item">New friend request</div>
              <div class="dropdown-item">Page liked your post</div>
              <div class="dropdown-item">3 new reactions</div>
            </div>
          `);
          toggleDropdown(dropdown);
        });
      }
  
      // Messenger Dropdown
      if (messengerIcon) {
        messengerIcon.addEventListener('click', function(e) {
          e.stopPropagation();
          const dropdown = createDropdown(messengerIcon, `
            <div class="dropdown-content">
              <div class="dropdown-header">Messenger</div>
              <div class="dropdown-item">New message from Sarah</div>
              <div class="dropdown-item">Mark replied to your message</div>
              <div class="dropdown-item">5 unread conversations</div>
            </div>
          `);
          toggleDropdown(dropdown);
        });
      }
  
      // Close dropdowns when clicking elsewhere or pressing Escape
      document.addEventListener('click', closeAllDropdowns);
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          closeAllDropdowns();
        }
      });
  
      // Add hover effects
      const headerIcons = document.querySelectorAll('.menu-icon, .notification-icon, .messenger-icon, .user-icon');
      headerIcons.forEach(icon => {
        icon.addEventListener('mouseenter', function() {
          this.style.backgroundColor = '#f0f2f5';
        });
        icon.addEventListener('mouseleave', function() {
          this.style.backgroundColor = '';
        });
      });
    });
  </script>
  
  <style>
    /* Add these styles to your existing CSS */
    .dropdown {
      display: none;
      position: absolute;
      background: #fff;
      border-radius: 8px;
      box-shadow: 0 12px 28px 0 rgba(0,0,0,0.2);
      width: 360px;
      padding: 8px 0;
      z-index: 2000;
      right: 0;
      top: 100%;
    }
  
    .dropdown-content {
      padding: 8px 0;
    }
  
    .dropdown-header {
      padding: 8px 16px;
      font-weight: 600;
      font-size: 16px;
      border-bottom: 1px solid #ddd;
      margin-bottom: 8px;
    }
  
    .dropdown-item {
      padding: 8px 16px;
      cursor: pointer;
    }
  
    .dropdown-item:hover {
      background: #f0f2f5;
    }
  
    /* Animation for dropdowns */
    .menu-dropdown, .user-dropdown, .dropdown {
      transform-origin: top right;
      animation: fadeIn 0.2s ease-out;
    }
  
    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: scale(0.95) translateY(-10px);
      }
      to {
        opacity: 1;
        transform: scale(1) translateY(0);
      }
    }
  </style>