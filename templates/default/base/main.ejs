<!-- main.ejs (to be rendered below post-creator) -->
<div class="feed-container">
  <% if (typeof posts !== 'undefined' && posts.length > 0) { %>
      <% posts.forEach(post => { %>
          <div class="post-card">
              <div class="post-header">
                  <img src="<%= post.user.avatar || '/assets/images/default-avatar.jpg' %>" 
                       alt="<%= post.user.name %>" 
                       class="post-avatar"
                       onerror="this.onerror=null;this.src='/assets/images/default-avatar.jpg'">
                  <div class="post-user-info">
                      <span class="post-username"><%= post.user.name %></span>
                      <span class="post-time"><%= new Date(post.createdAt).toLocaleString() %></span>
                      <span class="post-privacy">
                          <i class="fas fa-<%= post.privacy === 'EVERYONE' ? 'globe' : (post.privacy === 'FRIENDS' ? 'user-friends' : 'lock') %>"></i>
                      </span>
                  </div>
              </div>
              
              <div class="post-content">
                  <p><%= post.content %></p>
                  <% if (post.media && post.media.length > 0) { %>
                      <div class="post-media">
                          <% post.media.forEach(media => { %>
                              <% if (media.type.startsWith('image')) { %>
                                  <img src="<%= media.url %>" alt="Post image" class="post-image">
                              <% } else if (media.type.startsWith('video')) { %>
                                  <video controls class="post-video">
                                      <source src="<%= media.url %>" type="<%= media.type %>">
                                  </video>
                              <% } %>
                          <% }); %>
                      </div>
                  <% } %>
              </div>
              
              <div class="post-stats">
                  <span class="post-likes"><i class="fas fa-thumbs-up"></i> <%= post.likes || 0 %></span>
                  <span class="post-comments"><%= post.comments || 0 %> comments</span>
                  <span class="post-shares"><%= post.shares || 0 %> shares</span>
              </div>
              
              <div class="post-actions">
                  <button class="post-action like-btn" data-post-id="<%= post._id %>">
                      <i class="far fa-thumbs-up"></i> Like
                  </button>
                  <button class="post-action comment-btn" data-post-id="<%= post._id %>">
                      <i class="far fa-comment"></i> Comment
                  </button>
                  <button class="post-action share-btn" data-post-id="<%= post._id %>">
                      <i class="far fa-share-square"></i> Share
                  </button>
              </div>
              
              <% if (post.relatedPosts && post.relatedPosts.length > 0) { %>
                  <div class="related-posts">
                      <h4>Related Posts</h4>
                      <% post.relatedPosts.forEach(related => { %>
                          <div class="related-post">
                              <img src="<%= related.user.avatar || '/assets/images/default-avatar.jpg' %>" 
                                   alt="<%= related.user.name %>" 
                                   class="related-avatar">
                              <div class="related-content">
                                  <span class="related-username"><%= related.user.name %></span>
                                  <p class="related-text"><%= related.content.substring(0, 100) %><%= related.content.length > 100 ? '...' : '' %></p>
                              </div>
                          </div>
                      <% }); %>
                  </div>
              <% } %>
          </div>
      <% }); %>
  <% } else { %>
      <div class="empty-feed">
          <p>No posts to show. Be the first to post something!</p>
      </div>
  <% } %>
</div>


<style>
   /* Feed Styles */
   .feed-container {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }
    
    .post-card {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.1);
        padding: 16px;
    }
    
    .post-header {
        display: flex;
        align-items: center;
        margin-bottom: 12px;
    }
    
    .post-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        object-fit: cover;
        margin-right: 12px;
    }
    
    .post-user-info {
        display: flex;
        flex-direction: column;
    }
    
    .post-username {
        font-weight: 600;
    }
    
    .post-time {
        font-size: 12px;
        color: #65676b;
    }
    
    .post-privacy {
        font-size: 12px;
        color: #65676b;
    }
    
    .post-content {
        margin-bottom: 12px;
    }
    
    .post-media {
        margin-top: 12px;
    }
    
    .post-image {
        max-width: 100%;
        max-height: 500px;
        border-radius: 8px;
    }
    
    .post-video {
        width: 100%;
        max-height: 500px;
        border-radius: 8px;
    }
    
    .post-stats {
        display: flex;
        align-items: center;
        padding: 8px 0;
        border-top: 1px solid #ddd;
        border-bottom: 1px solid #ddd;
        color: #65676b;
        font-size: 14px;
    }
    
    .post-stats span {
        margin-right: 16px;
    }
    
    .post-actions {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
    }
    
    .post-action {
        flex: 1;
        background: none;
        border: none;
        padding: 8px;
        border-radius: 4px;
        cursor: pointer;
        color: #65676b;
        font-weight: 600;
    }
    
    .post-action:hover {
        background: #f0f2f5;
    }
    
    /* Related Posts */
    .related-posts {
        margin-top: 16px;
        padding-top: 16px;
        border-top: 1px solid #ddd;
    }
    
    .related-posts h4 {
        margin-bottom: 8px;
        font-size: 16px;
    }
    
    .related-post {
        display: flex;
        align-items: center;
        margin-bottom: 8px;
        padding: 8px;
        border-radius: 8px;
        background: #f0f2f5;
    }
    
    .related-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        object-fit: cover;
        margin-right: 8px;
    }
    
    .related-content {
        flex: 1;
    }
    
    .related-username {
        font-weight: 600;
        font-size: 14px;
    }
    
    .related-text {
        font-size: 13px;
        color: #65676b;
        margin: 0;
    }
</style>