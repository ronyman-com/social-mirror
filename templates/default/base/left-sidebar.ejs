<div class="left-sidebar">
  <div class="sidebar-content">
    <%- include('./friend') %>
    <div class="sidebar-section">
      <h3>Shortcuts</h3>
      <%- include('./your-shortcut') %>
    </div>
  </div>
  <div class="sidebar-footer">
    <%- include('./footer') %>
  </div>
</div>

<style>
  /* Left Sidebar Styles */
  .left-sidebar {
    width: 360px;
    height: calc(100vh - 56px);
    position: fixed;
    left: 0;
    top: 56px;
    display: flex;
    flex-direction: column;
    background: #fff;
    z-index: 900;
    transform: translateX(-100%);
    transition: transform 0.3s ease;
  }

  .left-sidebar.active {
    transform: translateX(0);
  }

  .sidebar-content {
    flex: 1;
    overflow-y: auto;
    padding: 20px 16px;
  }

  .sidebar-footer {
    padding: 16px;
    border-top: 1px solid #dadde1;
    background: #fff;
  }

  .sidebar-section {
    margin-bottom: 20px;
  }

  .sidebar-section h3 {
    color: #65676b;
    font-size: 17px;
    font-weight: 600;
    padding: 8px 0;
    margin-left: 8px;
  }

  /* Custom scrollbar */
  .sidebar-content::-webkit-scrollbar {
    width: 8px;
  }

  .sidebar-content::-webkit-scrollbar-thumb {
    background-color: #ccd0d5;
    border-radius: 8px;
  }

  @media (min-width: 1101px) {
    .left-sidebar {
      transform: translateX(0);
    }
  }
</style>

<script>
  // Toggle mobile menu
  document.querySelector('.mobile-menu-toggle').addEventListener('click', function() {
    document.querySelector('.left-sidebar').classList.toggle('active');
  });
</script>