<div class="marketplace-section card">
    <div class="section-header">
      <h3><i class="fas fa-store"></i> Marketplace</h3>
      <button class="icon-button" onclick="openMarketplace()">
        <i class="fas fa-chevron-right"></i>
      </button>
    </div>
    
    <div class="marketplace-items">
      <% if (typeof marketplaceItems !== 'undefined' && marketplaceItems.length > 0) { %>
        <% marketplaceItems.slice(0, 2).forEach(item => { %>
          <div class="marketplace-item">
            <img src="<%= item.image %>" alt="<%= item.title %>">
            <div class="item-details">
              <p class="item-price"><%= item.price %></p>
              <p class="item-title"><%= item.title %></p>
              <p class="item-location"><%= item.location %></p>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="no-items">
          <i class="fas fa-store-slash"></i>
          <p>No marketplace items</p>
        </div>
      <% } %>
    </div>
    
    <button class="view-all" onclick="openMarketplace()">
      See More in Marketplace
    </button>
  </div>
  
  <style>
  .marketplace-section {
    padding: 12px;
    margin-bottom: 16px;
  }
  
  .marketplace-items {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  
  .marketplace-item {
    display: flex;
    gap: 12px;
    cursor: pointer;
  }
  
  .marketplace-item img {
    width: 80px;
    height: 80px;
    border-radius: 8px;
    object-fit: cover;
  }
  
  .item-details {
    flex: 1;
  }
  
  .item-price {
    font-weight: bold;
    color: var(--text-primary);
  }
  
  .item-title {
    font-size: 14px;
    color: var(--text-primary);
  }
  
  .item-location {
    font-size: 12px;
    color: var(--text-secondary);
  }
  
  .no-items {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 16px;
    color: var(--text-secondary);
  }
  
  .no-items i {
    font-size: 24px;
    margin-bottom: 8px;
  }
  </style>
  
  <script>
  function openMarketplace() {
    // Implement marketplace opening
    console.log('Opening Marketplace');
  }
  </script>