<header>
    <div class="header-container">
      <!-- Logo -->
      <div class="logo-container">
        <a href="/">
          <img class="logo" src="/assets/images/facebook-logo.png" alt="Facebook" onerror="this.src='/assets/images/default-logo.png'">
        </a>
      </div>
  
      <!-- Search Bar -->
      <div class="search-bar">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="#65676b">
          <path d="M10.25 2a8.25 8.25 0 0 1 6.34 13.53l5.69 5.69a.75.75 0 0 1-1.06 1.06l-5.69-5.69A8.25 8.25 0 1 1 10.25 2ZM3.5 10.25a6.75 6.75 0 1 0 13.5 0 6.75 6.75 0 0 0-13.5 0Z"></path>
        </svg>
        <input type="text" placeholder="Search Facebook">
      </div>
  
      <!-- Navigation Icons -->
      <div class="nav-icons">
        <div class="nav-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="#050505">
            <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8h5Z"></path>
          </svg>
        </div>
        <div class="nav-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="#050505">
            <path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92 1.61 0 2.92-1.31 2.92-2.92s-1.31-2.92-2.92-2.92Z"></path>
          </svg>
        </div>
        <div class="nav-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="#050505">
            <path d="M16 12c0 .552-.448 1-1 1H9c-.552 0-1-.448-1-1s.448-1 1-1h6c.552 0 1 .448 1 1zm-1-5c.552 0 1 .448 1 1s-.448 1-1 1H9c-.552 0-1-.448-1-1s.448-1 1-1h6zm1 8c0 .552-.448 1-1 1H9c-.552 0-1-.448-1-1s.448-1 1-1h6c.552 0 1 .448 1 1z"></path>
          </svg>
        </div>
        <div class="nav-icon">
          <% if (typeof user !== 'undefined' && user) { %>
            <img class="profile-pic" src="<%= user.avatar || '/assets/images/default-avatar.jpg' %>" alt="Profile">
          <% } else { %>
            <div class="profile-placeholder"></div>
          <% } %>
        </div>
      </div>
    </div>
  </header>