<div class="pages-manage-container">
    <div class="pages-header">
        <h2>Manage Pages</h2>
        <button class="create-page-btn">
            <i class="fas fa-plus"></i> Create New Page
        </button>
    </div>

    <div class="pages-search">
        <div class="search-input-container">
            <i class="fas fa-search"></i>
            <input type="text" placeholder="Search pages" class="search-input">
        </div>
    </div>

    <div class="pages-tabs">
        <button class="tab-btn active">Your Pages</button>
        <button class="tab-btn">Pages You Follow</button>
        <button class="tab-btn">Invitations</button>
    </div>

    <div class="pages-list">
        <% if (typeof pages !== 'undefined' && pages.length > 0) { %>
            <% pages.forEach(page => { %>
                <div class="page-item">
                    <div class="page-avatar">
                        <% if (page.avatar) { %>
                            <img src="<%= page.avatar %>" alt="<%= page.name %>">
                        <% } else { %>
                            <i class="fas fa-flag"></i>
                        <% } %>
                    </div>
                    <div class="page-info">
                        <h4><%= page.name %></h4>
                        <p><%= page.category %></p>
                        <div class="page-stats">
                            <span><i class="fas fa-users"></i> <%= page.followers %> followers</span>
                            <% if (page.newNotifications > 0) { %>
                                <span class="notification-badge"><%= page.newNotifications %> new notifications</span>
                            <% } %>
                        </div>
                    </div>
                    <div class="page-actions">
                        <button class="page-action-btn">
                            <i class="fas fa-ellipsis-h"></i>
                        </button>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <div class="no-pages">
                <i class="fas fa-flag"></i>
                <p>You don't have any pages yet</p>
            </div>
        <% } %>
    </div>
</div>

<style>
    .pages-manage-container {
        background: #fff;
        border-radius: 8px;
        padding: 16px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
    }

    .pages-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .pages-header h2 {
        margin: 0;
        font-size: 20px;
    }

    .create-page-btn {
        background: #1877f2;
        color: white;
        border: none;
        border-radius: 6px;
        padding: 8px 12px;
        font-weight: 600;
        cursor: pointer;
    }

    .pages-search {
        margin-bottom: 16px;
    }

    .search-input-container {
        position: relative;
    }

    .search-input-container i {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #65676b;
    }

    .search-input {
        width: 100%;
        padding: 10px 10px 10px 40px;
        border-radius: 50px;
        border: 1px solid #ddd;
        font-size: 15px;
    }

    .pages-tabs {
        display: flex;
        border-bottom: 1px solid #ddd;
        margin-bottom: 16px;
    }

    .tab-btn {
        padding: 12px 16px;
        background: none;
        border: none;
        font-weight: 600;
        color: #65676b;
        cursor: pointer;
        position: relative;
    }

    .tab-btn.active {
        color: #1877f2;
    }

    .tab-btn.active::after {
        content: '';
        position: absolute;
        bottom: -1px;
        left: 0;
        right: 0;
        height: 3px;
        background: #1877f2;
    }

    .page-item {
        display: flex;
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 8px;
        align-items: center;
    }

    .page-item:hover {
        background: #f0f2f5;
    }

    .page-avatar {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: #e4e6eb;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 12px;
        font-size: 24px;
        color: #65676b;
        overflow: hidden;
    }

    .page-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .page-info {
        flex: 1;
    }

    .page-info h4 {
        margin: 0 0 4px;
        font-size: 16px;
    }

    .page-info p {
        margin: 0 0 4px;
        font-size: 14px;
        color: #65676b;
    }

    .page-stats {
        display: flex;
        gap: 12px;
        font-size: 13px;
        color: #65676b;
    }

    .notification-badge {
        color: #1877f2;
        font-weight: 600;
    }

    .page-actions button {
        background: none;
        border: none;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: #65676b;
    }

    .page-actions button:hover {
        background: #e4e6eb;
    }

    .no-pages {
        text-align: center;
        padding: 40px;
        color: #65676b;
    }

    .no-pages i {
        font-size: 48px;
        margin-bottom: 16px;
    }

    .no-pages p {
        margin: 0;
        font-size: 16px;
    }
</style>