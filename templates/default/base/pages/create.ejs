<div class="create-page-container">
    <div class="create-page-header">
        <h2>Create a Page</h2>
        <p>Connect with your customers or fans with a Facebook Page</p>
    </div>

    <div class="create-page-steps">
        <div class="step active">
            <div class="step-number">1</div>
            <div class="step-info">
                <h4>Page Info</h4>
                <p>Basic information about your Page</p>
            </div>
        </div>
        <div class="step">
            <div class="step-number">2</div>
            <div class="step-info">
                <h4>Details</h4>
                <p>Add more details about your Page</p>
            </div>
        </div>
        <div class="step">
            <div class="step-number">3</div>
            <div class="step-info">
                <h4>Finish</h4>
                <p>Complete your Page setup</p>
            </div>
        </div>
    </div>

    <form class="create-page-form">
        <div class="form-group">
            <label for="pageName">Page Name</label>
            <input type="text" id="pageName" placeholder="E.g. My Business">
        </div>

        <div class="form-group">
            <label for="pageCategory">Category</label>
            <select id="pageCategory">
                <option value="">Select a category</option>
                <option value="business">Business or Brand</option>
                <option value="community">Community or Public Figure</option>
                <option value="entertainment">Entertainment</option>
                <option value="shopping">Shopping & Retail</option>
            </select>
        </div>

        <div class="form-group">
            <label for="pageDescription">Description</label>
            <textarea id="pageDescription" placeholder="Tell people what your Page is about"></textarea>
        </div>

        <div class="form-group">
            <label>Page Photo</label>
            <div class="upload-area" id="uploadArea">
                <i class="fas fa-camera"></i>
                <p>Add Profile Picture</p>
            </div>
        </div>

        <div class="form-actions">
            <button type="button" class="cancel-btn">Cancel</button>
            <button type="submit" class="continue-btn">Continue</button>
        </div>
    </form>
</div>

