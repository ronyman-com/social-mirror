<div class="auth-container">
    <div class="auth-header">
      <img src="/assets/brand/social-logo.png" alt="Social Mirror Logo" class="auth-logo">
      <h1>Sign in with Google</h1>
      <p>Connect to your Social Mirror account</p>
    </div>
  
    <div class="auth-body">
      <button id="googleSignIn" class="google-signin-btn">
        <img src="https://upload.wikimedia.org/wikipedia/commons/5/53/Google_%22G%22_Logo.svg" alt="Google logo">
        <span>Continue with Google</span>
      </button>
  
      <div class="auth-divider">
        <span>or</span>
      </div>
  
      <div class="auth-footer">
        <p>Don't have an account? <a href="/signup">Sign up</a></p>
        <p class="auth-terms">By continuing, you agree to our <a href="/terms">Terms</a> and <a href="/privacy">Privacy Policy</a>.</p>
      </div>
    </div>
  </div>
  
  <script type="module" src="/js/auth/google.js"></script>