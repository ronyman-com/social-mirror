<%- include('../base/partials/header', { 
    title: 'Forgot Password',
    styles: ['/css/auth.css'] 
  }) %>
  
  <div class="auth-container">
      <div class="login-box">
          <div class="logo">
              <img src="/images/logo.png" alt="Facebook Mirror" class="logo-image">
          </div>
          
          <h1 class="auth-title">Reset Your Password</h1>
          <p class="auth-subtitle">Enter your email to receive a password reset link</p>
          
          <!-- Enhanced Message Handling -->
          <% const messageList = typeof messages !== 'undefined' ? messages : []; %>
          <% if (messageList.length) { %>
              <div class="alert alert-<%= messageList[0].type || 'danger' %>">
                  <i class="icon <%= messageList[0].type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle' %>"></i>
                  <%= messageList[0].text %>
              </div>
          <% } %>
  
          <div class="login-options">
              <form action="/auth/forgot-password" method="POST" class="email-login" id="forgotPasswordForm">
                  <div class="form-group">
                      <input 
                          type="email" 
                          name="email" 
                          id="resetEmail"
                          placeholder="Email address"
                          required
                          autocomplete="email"
                      >
                  </div>
                  <button type="submit" class="btn-login">
                      <i class="fas fa-paper-plane"></i> Send Reset Link
                  </button>
              </form>
              
              <div class="divider">or</div>
              
              <div class="alternative-options">
                  <a href="/auth/login" class="btn-fb-login">
                      <i class="fab fa-facebook"></i>
                      Continue with Facebook
                  </a>
                  <a href="/auth/login" class="btn-secondary">
                      <i class="fas fa-sign-in-alt"></i>
                      Return to Login
                  </a>
              </div>
          </div>
          
          <div class="signup-prompt">
              <p>Don't have an account? <a href="/auth/signup">Sign up</a></p>
          </div>
      </div>
  </div>
  
  <%- include('../base/partials/footer') %>
  
  <style>
      /* Enhanced Forgot Password Specific Styles */
      .alternative-options {
          display: flex;
          flex-direction: column;
          gap: 12px;
          margin-top: 15px;
      }
      
      #forgotPasswordForm {
          margin-bottom: 20px;
      }
      
      .btn-login[type="submit"] {
          width: 100%;
          margin-top: 15px;
          padding: 12px;
      }
      
      .alert {
          padding: 12px 15px;
          border-radius: 8px;
          margin: 15px 0;
          display: flex;
          align-items: center;
          gap: 10px;
          font-size: 14px;
      }
      
      .alert i {
          font-size: 18px;
      }
      
      .alert-danger {
          background-color: #fef2f2;
          color: #dc2626;
          border: 1px solid #fecaca;
      }
      
      .alert-success {
          background-color: #f0fdf4;
          color: #16a34a;
          border: 1px solid #bbf7d0;
      }
      
      .btn-secondary {
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 8px;
          padding: 10px;
          background: #f3f4f6;
          color: #4b5563;
          border-radius: 6px;
          text-align: center;
      }
      
      .btn-secondary:hover {
          background: #e5e7eb;
      }
  </style>
  
  <script>
      // Client-side form validation
      document.getElementById('forgotPasswordForm').addEventListener('submit', function(e) {
          const email = document.getElementById('resetEmail').value;
          if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
              e.preventDefault();
              alert('Please enter a valid email address');
          }
      });
  </script>