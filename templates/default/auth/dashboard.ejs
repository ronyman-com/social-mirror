<!-- templates/default/auth/dashboard.ejs -->
<div class="dashboard-container">
    <!-- Facebook SDK Injection -->
    <%- plugins.facebook.sdkScript %>
    
    <!-- Dashboard Header -->
    <header class="dashboard-header">
      <div class="user-profile">
        <img src="<%= user.avatar || '/images/default-avatar.jpg' %>" alt="<%= user.name %>" class="profile-avatar">
        <div class="profile-info">
          <h2><%= user.name %></h2>
          <p><%= user.email %></p>
        </div>
      </div>
      <button class="btn-edit-profile" onclick="loadView('profile/edit')">
        <i class="fas fa-pencil-alt"></i> Edit Profile
      </button>
    </header>
  
    <!-- Dashboard Navigation -->
    <nav class="dashboard-nav">
      <ul>
        <li class="active" data-tab="overview">
          <i class="fas fa-home"></i> Overview
        </li>
        <li data-tab="activity">
          <i class="fas fa-chart-line"></i> Activity
        </li>
        <li data-tab="security">
          <i class="fas fa-shield-alt"></i> Security
        </li>
        <li data-tab="sessions">
          <i class="fas fa-desktop"></i> Active Sessions
        </li>
        <li data-tab="integrations">
          <i class="fas fa-plug"></i> Integrations
        </li>
      </ul>
    </nav>
  
    <!-- Dashboard Content -->
    <main class="dashboard-content">
      <!-- Overview Tab (Default) -->
      <section class="tab-content active" id="overview-tab">
        <div class="stats-grid">
          <div class="stat-card">
            <i class="fas fa-user-friends"></i>
            <h3>Friends</h3>
            <p><%= user.friendsCount || 0 %> connections</p>
          </div>
          <div class="stat-card">
            <i class="fas fa-calendar-check"></i>
            <h3>Events</h3>
            <p><%= user.eventsCount || 0 %> upcoming</p>
          </div>
          <div class="stat-card">
            <i class="fas fa-bell"></i>
            <h3>Notifications</h3>
            <p><%= user.unreadNotifications || 0 %> unread</p>
          </div>
        </div>
  
        <div class="quick-actions">
          <h3>Quick Actions</h3>
          <div class="action-buttons">
            <button class="action-btn" onclick="loadView('posts/create')">
              <i class="fas fa-edit"></i> Create Post
            </button>
            <button class="action-btn" onclick="loadView('photos/upload')">
              <i class="fas fa-camera"></i> Upload Photos
            </button>
            <button class="action-btn" onclick="loadView('events/create')">
              <i class="fas fa-calendar-plus"></i> Create Event
            </button>
          </div>
        </div>
      </section>
  
      <!-- Activity Tab -->
      <section class="tab-content" id="activity-tab">
        <h2>Recent Activity</h2>
        <div class="activity-log" id="activity-log">
          <div class="loading-spinner">
            <i class="fas fa-spinner fa-spin"></i> Loading activity...
          </div>
        </div>
      </section>
  
      <!-- Security Tab -->
      <section class="tab-content" id="security-tab">
        <div class="security-settings">
          <div class="setting-card">
            <h3><i class="fas fa-key"></i> Password</h3>
            <p>Last changed: <%= user.passwordLastChanged || 'Never' %></p>
            <button class="btn-change-password" onclick="loadView('auth/change-password')">
              Change Password
            </button>
          </div>
          
          <div class="setting-card">
            <h3><i class="fas fa-mobile-alt"></i> Two-Factor Authentication</h3>
            <p>Status: <%= user.twoFactorEnabled ? 'Enabled' : 'Disabled' %></p>
            <button class="btn-toggle-2fa" onclick="toggleTwoFactor()">
              <%= user.twoFactorEnabled ? 'Disable' : 'Enable' %> 2FA
            </button>
          </div>
          
          <div class="setting-card">
            <h3><i class="fas fa-shield-alt"></i> Login Alerts</h3>
            <p>Receive notifications for new logins</p>
            <label class="switch">
              <input type="checkbox" <%= user.loginAlerts ? 'checked' : '' %>>
              <span class="slider round"></span>
            </label>
          </div>
        </div>
      </section>
  
      <!-- Active Sessions Tab -->
      <section class="tab-content" id="sessions-tab">
        <div class="sessions-list">
          <h2>Active Sessions</h2>
          <table>
            <thead>
              <tr>
                <th>Device</th>
                <th>Location</th>
                <th>Last Active</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="sessions-table-body">
              <!-- Sessions will be loaded here -->
            </tbody>
          </table>
        </div>
      </section>
  
      <!-- Integrations Tab -->
      <section class="tab-content" id="integrations-tab">
        <div class="connected-apps">
          <h2>Connected Apps</h2>
          <div class="apps-grid" id="connected-apps">
            <!-- Apps will be loaded here -->
          </div>
        </div>
      </section>
    </main>
  </div>
  
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Tab switching functionality
      document.querySelectorAll('.dashboard-nav li').forEach(tab => {
        tab.addEventListener('click', () => {
          // Update active tab
          document.querySelector('.dashboard-nav li.active').classList.remove('active');
          tab.classList.add('active');
          
          // Show corresponding content
          const tabId = tab.getAttribute('data-tab');
          document.querySelector('.tab-content.active').classList.remove('active');
          document.getElementById(`${tabId}-tab`).classList.add('active');
        });
      });
  
      // Load sessions data
      loadSessions();
  
      // Load connected apps
      loadConnectedApps();
  
      // Load activity log
      loadActivityLog();
    });
  
    async function loadSessions() {
      try {
        const response = await fetch('/api/auth/sessions');
        const sessions = await response.json();
        
        const tableBody = document.getElementById('sessions-table-body');
        tableBody.innerHTML = sessions.map(session => `
          <tr>
            <td>
              <i class="fas fa-${session.deviceType === 'mobile' ? 'mobile-alt' : 'desktop'}"></i>
              ${session.browser} on ${session.os}
            </td>
            <td>${session.location}</td>
            <td>${session.lastActive}</td>
            <td>
              <button class="btn-session-action" onclick="revokeSession('${session.id}')">
                <i class="fas fa-sign-out-alt"></i> Revoke
              </button>
            </td>
          </tr>
        `).join('');
      } catch (error) {
        console.error('Failed to load sessions:', error);
      }
    }
  
    async function loadConnectedApps() {
      try {
        const response = await fetch('/api/auth/connected-apps');
        const apps = await response.json();
        
        const appsGrid = document.getElementById('connected-apps');
        appsGrid.innerHTML = apps.map(app => `
          <div class="app-card">
            <img src="${app.logo}" alt="${app.name}">
            <h4>${app.name}</h4>
            <p>Connected since ${app.connectedSince}</p>
            <button class="btn-disconnect" onclick="disconnectApp('${app.id}')">
              Disconnect
            </button>
          </div>
        `).join('');
      } catch (error) {
        console.error('Failed to load connected apps:', error);
      }
    }
  
    async function loadActivityLog() {
      try {
        const response = await fetch('/api/auth/activity');
        const activities = await response.json();
        
        const activityLog = document.getElementById('activity-log');
        activityLog.innerHTML = activities.map(activity => `
          <div class="activity-item">
            <div class="activity-icon">
              <i class="fas fa-${getActivityIcon(activity.type)}"></i>
            </div>
            <div class="activity-details">
              <p>${activity.description}</p>
              <small>${activity.timestamp}</small>
            </div>
          </div>
        `).join('');
      } catch (error) {
        console.error('Failed to load activity log:', error);
      }
    }
  
    function getActivityIcon(type) {
      const icons = {
        login: 'sign-in-alt',
        logout: 'sign-out-alt',
        post: 'edit',
        like: 'thumbs-up',
        comment: 'comment',
        security: 'shield-alt'
      };
      return icons[type] || 'circle';
    }
  
    async function toggleTwoFactor() {
      try {
        const response = await fetch('/api/auth/toggle-2fa', {
          method: 'POST'
        });
        const result = await response.json();
        
        if (result.success) {
          window.location.reload();
        } else {
          alert(result.message || 'Failed to update 2FA settings');
        }
      } catch (error) {
        console.error('2FA toggle failed:', error);
        alert('An error occurred');
      }
    }
  
    async function revokeSession(sessionId) {
      if (!confirm('Are you sure you want to revoke this session?')) return;
      
      try {
        const response = await fetch(`/api/auth/revoke-session/${sessionId}`, {
          method: 'DELETE'
        });
        const result = await response.json();
        
        if (result.success) {
          loadSessions();
        } else {
          alert(result.message || 'Failed to revoke session');
        }
      } catch (error) {
        console.error('Session revocation failed:', error);
      }
    }
  
    async function disconnectApp(appId) {
      if (!confirm('Are you sure you want to disconnect this app?')) return;
      
      try {
        const response = await fetch(`/api/auth/disconnect-app/${appId}`, {
          method: 'DELETE'
        });
        const result = await response.json();
        
        if (result.success) {
          loadConnectedApps();
        } else {
          alert(result.message || 'Failed to disconnect app');
        }
      } catch (error) {
        console.error('App disconnection failed:', error);
      }
    }
  </script>
  
  <style>
    /* Dashboard Layout */
    .dashboard-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 20px;
    }
  
    /* Header Styles */
    .dashboard-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
      padding-bottom: 20px;
      border-bottom: 1px solid #e4e6eb;
    }
  
    .user-profile {
      display: flex;
      align-items: center;
      gap: 15px;
    }
  
    .profile-avatar {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid #1877f2;
    }
  
    .profile-info h2 {
      margin: 0;
      color: #1c1e21;
    }
  
    .profile-info p {
      margin: 5px 0 0;
      color: #65676b;
    }
  
    .btn-edit-profile {
      background: #e7f3ff;
      color: #1877f2;
      border: none;
      padding: 10px 15px;
      border-radius: 6px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
    }
  
    .btn-edit-profile:hover {
      background: #d8e7ff;
    }
  
    /* Navigation Styles */
    .dashboard-nav {
      margin-bottom: 30px;
    }
  
    .dashboard-nav ul {
      display: flex;
      gap: 10px;
      list-style: none;
      padding: 0;
      margin: 0;
      border-bottom: 1px solid #e4e6eb;
    }
  
    .dashboard-nav li {
      padding: 12px 20px;
      cursor: pointer;
      color: #65676b;
      border-bottom: 3px solid transparent;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 8px;
    }
  
    .dashboard-nav li:hover {
      color: #1877f2;
      background: #f0f2f5;
      border-radius: 6px 6px 0 0;
    }
  
    .dashboard-nav li.active {
      color: #1877f2;
      border-bottom-color: #1877f2;
    }
  
    /* Tab Content Styles */
    .tab-content {
      display: none;
    }
  
    .tab-content.active {
      display: block;
    }
  
    /* Stats Grid */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
      margin-bottom: 30px;
    }
  
    .stat-card {
      background: white;
      border-radius: 8px;
      padding: 20px;
      box-shadow: 0 1px 2px rgba(0,0,0,0.1);
      text-align: center;
    }
  
    .stat-card i {
      font-size: 24px;
      color: #1877f2;
      margin-bottom: 10px;
    }
  
    .stat-card h3 {
      margin: 10px 0 5px;
      color: #1c1e21;
    }
  
    .stat-card p {
      color: #65676b;
      margin: 0;
    }
  
    /* Quick Actions */
    .quick-actions {
      background: white;
      border-radius: 8px;
      padding: 20px;
      box-shadow: 0 1px 2px rgba(0,0,0,0.1);
      margin-bottom: 30px;
    }
  
    .quick-actions h3 {
      margin-top: 0;
      color: #1c1e21;
    }
  
    .action-buttons {
      display: flex;
      gap: 15px;
      flex-wrap: wrap;
    }
  
    .action-btn {
      background: #f0f2f5;
      border: none;
      padding: 12px 20px;
      border-radius: 6px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
    }
  
    .action-btn:hover {
      background: #e4e6eb;
    }
  
    /* Activity Log */
    .activity-log {
      background: white;
      border-radius: 8px;
      padding: 20px;
      box-shadow: 0 1px 2px rgba(0,0,0,0.1);
    }
  
    .activity-item {
      display: flex;
      gap: 15px;
      padding: 15px 0;
      border-bottom: 1px solid #e4e6eb;
    }
  
    .activity-item:last-child {
      border-bottom: none;
    }
  
    .activity-icon i {
      font-size: 18px;
      color: #1877f2;
    }
  
    .activity-details p {
      margin: 0;
      color: #1c1e21;
    }
  
    .activity-details small {
      color: #65676b;
      font-size: 0.8rem;
    }
  
    /* Security Settings */
    .security-settings {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 20px;
    }
  
    .setting-card {
      background: white;
      border-radius: 8px;
      padding: 20px;
      box-shadow: 0 1px 2px rgba(0,0,0,0.1);
    }
  
    .setting-card h3 {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: 0;
    }
  
    .setting-card p {
      color: #65676b;
      margin: 10px 0 15px;
    }
  
    .btn-change-password,
    .btn-toggle-2fa {
      background: #e7f3ff;
      color: #1877f2;
      border: none;
      padding: 8px 15px;
      border-radius: 6px;
      font-weight: 600;
      cursor: pointer;
    }
  
    .btn-change-password:hover,
    .btn-toggle-2fa:hover {
      background: #d8e7ff;
    }
  
    /* Switch Toggle */
    .switch {
      position: relative;
      display: inline-block;
      width: 60px;
      height: 34px;
    }
  
    .switch input {
      opacity: 0;
      width: 0;
      height: 0;
    }
  
    .slider {
      position: absolute;
      cursor: pointer;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: #ccc;
      transition: .4s;
    }
  
    .slider:before {
      position: absolute;
      content: "";
      height: 26px;
      width: 26px;
      left: 4px;
      bottom: 4px;
      background-color: white;
      transition: .4s;
    }
  
    input:checked + .slider {
      background-color: #1877f2;
    }
  
    input:checked + .slider:before {
      transform: translateX(26px);
    }
  
    .slider.round {
      border-radius: 34px;
    }
  
    .slider.round:before {
      border-radius: 50%;
    }
  
    /* Sessions Table */
    .sessions-list {
      background: white;
      border-radius: 8px;
      padding: 20px;
      box-shadow: 0 1px 2px rgba(0,0,0,0.1);
      overflow-x: auto;
    }
  
    table {
      width: 100%;
      border-collapse: collapse;
    }
  
    th, td {
      padding: 12px 15px;
      text-align: left;
      border-bottom: 1px solid #e4e6eb;
    }
  
    th {
      color: #65676b;
      font-weight: 600;
    }
  
    .btn-session-action {
      background: #f0f2f5;
      border: none;
      padding: 6px 12px;
      border-radius: 4px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 5px;
    }
  
    .btn-session-action:hover {
      background: #e4e6eb;
    }
  
    /* Connected Apps */
    .connected-apps {
      background: white;
      border-radius: 8px;
      padding: 20px;
      box-shadow: 0 1px 2px rgba(0,0,0,0.1);
    }
  
    .apps-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 20px;
      margin-top: 20px;
    }
  
    .app-card {
      background: #f0f2f5;
      border-radius: 8px;
      padding: 15px;
      text-align: center;
    }
  
    .app-card img {
      width: 60px;
      height: 60px;
      border-radius: 8px;
      object-fit: cover;
      margin-bottom: 10px;
    }
  
    .app-card h4 {
      margin: 10px 0 5px;
    }
  
    .app-card p {
      color: #65676b;
      font-size: 0.9rem;
      margin: 5px 0 10px;
    }
  
    .btn-disconnect {
      background: #fff4f4;
      color: #f3425f;
      border: none;
      padding: 6px 12px;
      border-radius: 4px;
      cursor: pointer;
    }
  
    .btn-disconnect:hover {
      background: #ffecec;
    }
  
    /* Loading States */
    .loading-spinner {
      text-align: center;
      padding: 30px;
      color: #65676b;
    }
  
    .loading-spinner i {
      margin-right: 10px;
    }
  
    /* Responsive Design */
    @media (max-width: 768px) {
      .dashboard-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
      }
  
      .dashboard-nav ul {
        overflow-x: auto;
        padding-bottom: 10px;
      }
  
      .action-buttons {
        flex-direction: column;
      }
  
      .action-btn {
        width: 100%;
        justify-content: center;
      }
    }
  </style>